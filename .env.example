# W&B API key. Required.
WANDB_API_KEY=your_wandb_api_key_here

# Dedicated Cloud URL. Leave empty for SaaS.
# WANDB_BASE_URL=https://your-org.wandb.io

# Optional. If unset, W&B uses your default entity.
# WANDB_ENTITY=your_entity_or_team

# Optional. Defaults to models-initial-course.
WANDB_PROJECT=models-initial-course
