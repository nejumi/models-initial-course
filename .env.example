# Multi-tenant SaaS が標準です。接続先で発行した API key を設定してください。
# ローカルでログイン済みなら空欄のまま使えます。
WANDB_API_KEY=

# 空欄: Multi-tenant SaaS (https://api.wandb.ai)
# Dedicated Cloud: 管理者から案内された URL に変更してください。
# 例: https://your-org.wandb.io
WANDB_BASE_URL=

# 任意: 実験を保存するチームとプロジェクト
WANDB_ENTITY=
WANDB_PROJECT=models-initial-course
